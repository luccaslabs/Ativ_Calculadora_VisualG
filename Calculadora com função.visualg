algoritmo "Calculadora com função"

var
  op: inteiro
  n1, n2: real

funcao somar(n1: real, n2: real): real
inicio
  retorne n1 + n2
fimfuncao

funcao subtrair(n1: real, n2: real): real
inicio
  retorne n1 - n2
fimfuncao

funcao multiplicar(n1: real, n2: real): real
inicio
  retorne n1 * n2
fimfuncao

funcao dividir(n1: real, n2: real): real
inicio
  retorne n1 / n2
fimfuncao

inicio
  op <- -1

  enquanto (op <> 0) faca
    escreval("0 - SAIR | 1 - SOMA | 2 - SUBTRACAO | 3 - MULTIPLICACAO | 4 - DIVISAO")
    escreva("Digite a opcao: ")
    leia(op)

    se (op = 0) entao
      interrompa
    fimse

    limpatela

    se (op >= 1) e (op <= 4) entao
      escreval("Digite o primeiro numero: ")
      leia(n1)
      escreval("Digite o segundo numero: ")
      leia(n2)

      escolha op
        caso 1
          escreval(somar(n1, n2))
        caso 2
          escreval(subtrair(n1, n2))
        caso 3
          escreval(multiplicar(n1, n2))
        caso 4
          se (n2 <> 0) entao
            escreval(dividir(n1, n2))
            
          senao
            escreval("Divisao por zero!")
          fimse
      fimescolha

      pausa 

    senao
      escreval("Opcao invalida!")
    fimse
  fimenquanto

fimalgoritmo